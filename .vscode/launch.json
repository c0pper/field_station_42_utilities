{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug with args",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "/home/simo/Downloads/ads",
                "--overwrite"
            ]
        },
        {
            "name": "MusicVideos: Create NFOs",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/create_music_video_nfo.py",
            "console": "integratedTerminal",
            "args": [
                "--dry-run"
            ]
        },
        {
            "name": "MusicVideos: Link NFOs to MTV/shows",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/create_music_video_nfo.py",
            "console": "integratedTerminal",
            "args": [
                "link-mtv",
                // "--dry-run"
            ]
        }
    ]
}